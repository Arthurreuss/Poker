# nginx im Web-Container (prod, WP-003). Wird beim Start per envsubst zu /etc/nginx/conf.d/default.conf;
# ersetzt werden nur gesetzte Umgebungsvariablen (API_UPSTREAM), nginx-Variablen wie $host bleiben.
# Eine Origin (D-014): statische App, /api/ und /ws laufen über denselben Host.
# Security-Header (WP-022): security-headers.conf, in jedem location-Block eingebunden (Test: scripts/test/nginx-headers.test.mjs).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Echte Client-IP: hinter Cloudflare aus CF-Connecting-IP (setzt Cloudflare immer neu), lokal die Peer-Adresse.
# Der Server vertraut X-Forwarded-* nur in prod (trustProxy, D-014).
map $http_cf_connecting_ip $client_ip {
    ''      $remote_addr;
    default $http_cf_connecting_ip;
}

# Access-Log (D-025): eigene Zeile mit der echten Client-IP statt des Formats "main" aus nginx.conf (das zusätzlich
# X-Forwarded-For mitschreibt). Ziel NGINX_ACCESS_LOG: stdout bzw. in prod eine Datei, die der Dienst logrotate
# täglich rotiert und nach spätestens 14 Tagen löscht. Healthchecks aus dem Container (127.0.0.1) werden nicht geloggt.
log_format poker '$client_ip [$time_local] "$request" $status $body_bytes_sent $request_time "$http_referer" "$http_user_agent"';

map $remote_addr $poker_access_log {
    127.0.0.1 0;
    default   1;
}

# Hinter dem Tunnel kommt https von cloudflared, lokal http.
map $http_x_forwarded_proto $forwarded_proto {
    ''      $scheme;
    default $http_x_forwarded_proto;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    access_log ${NGINX_ACCESS_LOG} poker if=$poker_access_log;

    # Docker-DNS; Variable in proxy_pass → Name wird zur Laufzeit aufgelöst (Server-Neustart ändert ggf. die IP).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://${API_UPSTREAM};

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $client_ip;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass $api_upstream;
        add_header Cache-Control "no-store" always;
    }

    # WebSocket: Upgrade-Header durchreichen, lange Timeouts (Heartbeat alle 30 s, D-014).
    location = /ws {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass $api_upstream;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # Von Vite gehashte Dateien ändern nie ihren Inhalt → lange cachen.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # PWA-Manifest: nginx kennt die Endung .webmanifest nicht (sonst application/octet-stream).
    location = /manifest.webmanifest {
        include /etc/nginx/snippets/security-headers.conf;
        types { }
        default_type application/manifest+json;
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    # index.html und alles andere: immer revalidieren, damit neue Releases sofort ankommen.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
