{
  "name": "poker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/engine",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "setup": "git config core.hooksPath .githooks",
    "dev:up": "docker compose -f compose.dev.yml -p poker-dev up -d --build --renew-anon-volumes",
    "dev:down": "docker compose -f compose.dev.yml -p poker-dev down",
    "dev:logs": "docker compose -f compose.dev.yml -p poker-dev logs -f",
    "prod:up": "bash scripts/prod-remote.sh up",
    "prod:down": "bash scripts/prod-remote.sh down",
    "prod:logs": "bash scripts/prod-remote.sh logs",
    "prod:tunnel:up": "bash scripts/prod-remote.sh tunnel-up",
    "prod:deploy": "bash scripts/fleet-deploy.sh deploy",
    "prod:rollback": "bash scripts/fleet-deploy.sh rollback",
    "prod:smoke": "bash scripts/prod-remote.sh smoke",
    "prod:e2e": "bash scripts/prod-remote.sh e2e",
    "prod:setup": "bash scripts/prod-host-setup.sh",
    "prod:backup": "bash scripts/prod-remote.sh backup",
    "prod:restore": "bash scripts/prod-remote.sh restore",
    "prod:status": "bash scripts/prod-remote.sh status",
    "prod:compose": "bash scripts/prod-remote.sh compose",
    "prod:ssh": "bash scripts/prod-remote.sh ssh",
    "prod:test-restore": "bash scripts/test-restore.sh",
    "release": "bash scripts/release.sh",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"scripts/test/**/*.test.mjs\" && vitest run",
    "docs:check": "node scripts/docs.mjs check",
    "docs:sync": "node scripts/docs.mjs sync",
    "check": "npm run docs:check && npm run format:check && npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
