# Vorlage für .env.prod (gitignored, NIE committen): cp .env.prod.example .env.prod
# Wird von compose.prod.yml gelesen (npm run prod:up). Anleitung: docs/OPERATIONS.md
# Ports: nur 4320–4329 für prod, gebunden an 127.0.0.1 (D-006).

# Host-Ports (nur lokal; öffentlich nur über den Cloudflare-Tunnel)
WEB_PORT=4320
SERVER_PORT=4321

# Postgres (prod). Passwort nur URL-sichere Zeichen, z. B.: openssl rand -hex 24
# Wirkt nur beim ersten Start mit leerem Volume poker-prod-db.
POSTGRES_USER=poker
POSTGRES_PASSWORD=
POSTGRES_DB=poker

# Öffentliche Origin(s) (Origin-Check beim WebSocket-Upgrade, D-014). Mehrere Domains kommagetrennt,
# die erste ist die Hauptadresse (D-023), z. B. https://poker.arthur-reuss.de,https://poker.deinemudda.win
PUBLIC_ORIGIN=https://poker.arthur-reuss.de,https://poker.deinemudda.win

# Token des Poker-Tunnels aus dem Cloudflare-Dashboard (nur für npm run prod:tunnel:up nötig).
TUNNEL_TOKEN=

# Backups (WP-021, D-037): Host-Ordner außerhalb von Docker-Volumes. Leer = /Users/Shared/fleet/backups/poker
# (gemeinsamer Backup-Ordner der Server, stündlich auf den Partner-Server gespiegelt).
# Anderer Ort → Datenschutzerklärung (Abschnitt 9 und 11) anpassen.
# Absoluter Pfad oder mit ~/ beginnend (die npm-Skripte lösen ~ auf; Compose selbst kann das nicht).
BACKUP_DIR=
# Zeitplan des täglichen Backups (go-cron, z. B. @daily = Mitternacht) und Zeitzone der Dateinamen.
BACKUP_SCHEDULE=@daily
BACKUP_TZ=Europe/Berlin

# Passphrase für die tägliche verschlüsselte Kopie dieser Datei (D-037, BACKUP_DIR/secrets/), z. B.: openssl rand -hex 32
# Zusätzlich im Passwort-Manager ablegen: Sie steht nur hier – geht die Datei verloren, ist ohne den Eintrag im
# Passwort-Manager auch die Sicherung nicht mehr zu öffnen. Leer = keine Sicherung der Secrets (laute Warnung im Backup-Log,
# npm run prod:status meldet einen Fehler; das DB-Backup läuft weiter).
SECRETS_BACKUP_PASSPHRASE=
