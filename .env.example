# Kopieren nach .env (gitignored) und bei Bedarf anpassen. Alle Werte haben Defaults in compose.dev.yml.
# Ports: nur 4310–4319 für dev, gebunden an 127.0.0.1 (D-006).

# Host-Ports
WEB_PORT=4310
SERVER_PORT=4311
DB_PORT=4312

# Postgres (nur dev – keine echten Geheimnisse)
POSTGRES_USER=poker
POSTGRES_PASSWORD=poker
POSTGRES_DB=poker

# Öffentliche Origin der App (Origin-Check, D-014); muss zu WEB_PORT passen.
PUBLIC_ORIGIN=http://localhost:4310

# true, falls Vite im Container keine Dateiänderungen bemerkt (Polling statt Events).
# Der Server (tsx watch) pollt in compose.dev.yml immer.
WEB_WATCH_POLLING=false

# --- Server-Variablen (setzt compose.dev.yml im Container; nur nötig beim Start ohne Docker) ---
# NODE_ENV=development
# HOST=127.0.0.1
# PORT=4311
# DATABASE_URL=postgres://poker:poker@localhost:4312/poker

# --- Auth (WP-010, Defaults im Code; Details docs/ARCHITECTURE.md „Auth“) ---
# NODE_ENV=production → Session-Cookie Secure, Client-IP für das Rate-Limit aus CF-Connecting-IP.
# SESSION_TTL_DAYS=30
# Login/Registrierung: Anfragen pro Fenster und IP (0 = aus), Fenster in Sekunden.
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Feedback (WP-024, Defaults im Code) ---
# Feedbacks pro Fenster und User (0 = aus), Fenster in Sekunden.
# FEEDBACK_RATE_LIMIT_MAX=5
# FEEDBACK_RATE_LIMIT_WINDOW_SECONDS=3600

# --- DB-Integrationstests (WP-009) ---
# Eigene Test-DB im dev-Postgres; wird bei Bedarf angelegt, jeder Testlauf nutzt ein eigenes Schema.
# Ohne diese Variable werden die DB-Tests übersprungen. `npm run test:db -w @poker/server` setzt diesen Default.
# TEST_DATABASE_URL=postgres://poker:poker@localhost:4312/poker_test

# --- Web-Dev-Server (setzt compose.dev.yml im Container) ---
# WEB_DEV_HOST=127.0.0.1
# WEB_DEV_PORT=4310
# API_PROXY_TARGET=http://localhost:4311
# VITE_USE_POLLING=false
