#!/bin/bash
# Commit-Hook von poker (.agents/rules/testing.md „Commit-Hook“): kein Commit auf main, dann die
# Stufe `static` (Wächter der fleet-Vorlage) über die Warteschlange des Verbunds mit der Quelle
# `commit`, bei Exit 75 lokal mit `scripts/ci_job.sh static`, danach `npm run check`.
# Eingerichtet über `git config core.hooksPath .githooks` (npm run setup, scripts/start.sh); der
# relative Pfad gilt in jedem Worktree für dessen eigenen Stand.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
exec </dev/null

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] && [ -z "${ALLOW_MAIN_COMMIT:-}" ]; then
  echo "✗ Kein direkter Commit auf main – main bekommt nur Releases von dev (.agents/rules/workflow.md)."
  echo "  Notfall: ALLOW_MAIN_COMMIT=1 git commit ..."
  exit 1
fi

PRUEFUNG_QUELLE=commit python3 scripts/pruefung.py static
rc=$?
if [ "$rc" -eq 75 ]; then
  echo "pre-commit: Warteschlange nicht nutzbar, prüfe lokal: scripts/ci_job.sh static" >&2
  scripts/ci_job.sh static
  rc=$?
fi
if [ "$rc" -ne 0 ]; then
  echo "pre-commit: Stufe static rot (Exit $rc), Commit aufgehalten" >&2
  exit "$rc"
fi

# Node-Version aus .nvmrc verwenden (Hook läuft auch aus Shells mit anderer Default-Version)
set +u  # nvm.sh liest ungesetzte Variablen
if [ -s "$HOME/.nvm/nvm.sh" ] && [ -f .nvmrc ]; then
  . "$HOME/.nvm/nvm.sh"
  nvm use --silent >/dev/null || exit 1
fi
npm run --silent check
