{
  "name": "@poker/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Game-Server (HTTP + WebSocket)",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@poker/engine": "*",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://poker:poker@localhost:4312/poker_test} vitest run",
    "admin:reset-password": "tsx src/cli/reset-password.ts",
    "admin:make-admin": "tsx src/cli/make-admin.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
